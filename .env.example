# llama-kv-proxy environment reference.
#
# The app reads these from the process environment (os.getenv). Docker Compose
# sets them for the container; for a bare `python -m app` run, export
# the ones you need (there is no automatic .env loading). Every variable is
# optional -- the defaults shown are what the app falls back to.

# --- Backends -------------------------------------------------------------
# Preferred: a JSON list of backends, each with a url and a slot count.
#   BACKENDS=[{"url": "http://127.0.0.1:8000", "n_slots": 2}]
# Fallback (used only when BACKENDS is unset): a single backend.
LLAMA_URL=http://127.0.0.1:8000
N_SLOTS=2

# --- Request / routing ----------------------------------------------------
# Model id used when the client does not send one and the backend id is unknown.
# Also the cache namespace of a model-less request, so change it when swapping
# the served model. A client `model` alias is mapped via the backend preset
# table (ids + aliases) instead, independent of which model is loaded.
MODEL_ID=llama.cpp
# Port the proxy listens on.
PORT=8081
# Overall HTTP timeout to a backend (seconds).
REQUEST_TIMEOUT=1500
# How long to wait for a free slot when all slots are busy (seconds); 503 after.
ACQUIRE_TIMEOUT=1500
# Max seconds a big request waits for an in-flight save of a prefix of its own
# conversation before giving up on the restore (the previous message's meta
# lands only after its .bin write). 0 disables the wait.
SAVE_WAIT_TIMEOUT=30
# Log level: DEBUG, INFO, WARNING, ERROR.
LOG_LEVEL=INFO

# --- Cache matching -------------------------------------------------------
# Words per block for the block-LCP fallback matcher.
WORDS_PER_BLOCK=100
# Requests with more words than this are "big" (restored + saved to disk).
BIG_THRESHOLD_WORDS=500
# Minimum LCP ratio (0..1) for a block-LCP restore candidate to be accepted.
LCP_TH=0.6

# --- Model id discovery ---------------------------------------------------
# TTL (seconds) for the cached backend model id.
MODEL_ID_TTL=60
# Timeout (seconds) for the /v1/models probe.
MODEL_ID_TIMEOUT=5
# Retry interval (seconds) while the model id is still unknown.
UNKNOWN_MODEL_ID_RETRY=5
# Timeout (seconds) for fetching a backend's /metrics during a scrape.
METRICS_TIMEOUT=5

# --- Slot discovery -------------------------------------------------------
# Interval (seconds) between backend slot-state polls (GET /slots).
SLOT_POLL_INTERVAL_S=30
# On-demand freshen: before picking a slot, the backends serving the request's
# model are re-polled at most once per this interval (seconds), so a slot
# cut/reload is observed quickly instead of waiting for the periodic poll.
# 0 disables the freshen.
SLOT_FRESHEN_INTERVAL_S=1.0

# --- Meta cache (local .meta descriptors) ---------------------------------
# Directory for .meta files, relative to the app directory.
META_DIR=kv_meta
# Evict metas older than this (hours).
META_TTL_H=24
# Evict when the number of meta files exceeds this.
META_MAX_FILES=1000
# Evict when the total meta size exceeds this (MB).
META_MAX_MB=512
# Interval (seconds) between periodic eviction runs.
EVICT_INTERVAL_S=3600
# In-memory restore index: 1 keeps the O(n) prefix-hash index in front of the
# on-disk two-tier scan (the scan stays the fallback). 0 disables the index.
META_INDEX_ENABLED=true
# Interval (seconds) between index<->disk reconciliations (drops ghost entries
# from external meta deletions). 0 disables the periodic reconcile.
META_INDEX_RECONCILE_INTERVAL_S=300

# --- Backend .bin cache (mounted --slot-save-path) ------------------------
# Directory holding llama.cpp .bin slot files (the host --slot-save-path).
# Empty disables direct .bin cleanup.
BIN_CACHE_DIR=
# Max total size (MB) of .bin files; oldest (LRU) are deleted first. 0 disables.
BIN_CACHE_MAX_MB=0
# Interval (seconds) between meta/.bin reconciliations. 0 disables.
BIN_RECONCILE_INTERVAL_S=600
# Grace window (seconds): a .bin without a meta modified within this window is
# treated as an in-flight save and skipped. 0 disables the guard.
BIN_SAVE_GRACE_S=10
# Minimum size (MB) of a saved .bin to count as a real slot save. Below this
# the save is treated as an empty capture (e.g. slot erased mid-generation)
# and discarded without writing a meta. 0 disables the check.
MIN_BIN_SIZE_VALID=1

# --- Request/response/prefix logging ---------------------------------------
# Directory for per-request JSON groups, named
# {timestamp_ms}.{request_id}.{type}.json: request (client body), response
# (backend body, or the assembled stream), prefix (the conversation the next
# message will be matched against), raw (stream only: the raw SSE). Relative
# to the app directory. Empty disables logging.
REQUEST_LOG_DIR=kv_reqlog
# Max number of request groups kept in the directory; oldest groups (all
# their files) are deleted first. 0 disables rotation (keep everything).
REQUEST_LOG_MAX_GROUPS=100

# --- Behavior -------------------------------------------------------------
# Erase a slot's KV cache before any chat that was NOT preceded by a
# successful restore, so it does not start on top of a stale or oversized
# prompt (can wedge llama.cpp in PROCESSING_PROMPT). On by default.
ERASE_BEFORE_CHAT=true
# Skip a pre-chat restore when the picked slot already holds the target key's
# KV (it just saved it, or it was restored there and unused since).
# On by default.
SKIP_RESTORE_SAME_SLOT=true
# Watchdog: a backend slot reporting is_processing for longer than this many
# seconds is presumed wedged and is erased to recover the backend.
# 0 disables the watchdog.
STUCK_SLOT_THRESHOLD_S=1500
# Include reasoning_content/reasoning in the cache key and the saved
# assistant response, so distinct reasoning traces get distinct cache keys.
# Off by default (keys byte-identical to the legacy behavior).
REASONING_IN_KEY=false

# --- Live dashboard (/proxy/ui/) ------------------------------------------
# 0 disables the dashboard (routes return 404). It serves prompt transcripts
# of recent requests -- keep it off on untrusted networks.
UI_ENABLED=true
# Number of finished requests kept in the in-memory history.
UI_HISTORY_MAX=200
# Max characters of the generated response kept per request as the live tail.
UI_TAIL_MAX_CHARS=16384
# Max characters of the prompt transcript shown in the request list.
UI_PREVIEW_MAX_CHARS=2048
# Cap for the full prompt transcript served on demand per request.
UI_PROMPT_FULL_MAX_CHARS=1048576
