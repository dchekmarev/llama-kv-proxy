# llama-kv-proxy environment reference.
#
# The app reads these from the process environment (os.getenv). Docker Compose
# sets them for the container; for a bare `python llama_kv_proxy.py` run, export
# the ones you need (there is no automatic .env loading). Every variable is
# optional -- the defaults shown are what the app falls back to.

# --- Backends -------------------------------------------------------------
# Preferred: a JSON list of backends, each with a url and a slot count.
#   BACKENDS=[{"url": "http://127.0.0.1:8000", "n_slots": 2}]
# Fallback (used only when BACKENDS is unset): a single backend.
LLAMA_URL=http://127.0.0.1:8000
N_SLOTS=2

# --- Request / routing ----------------------------------------------------
# Model id used when the client does not send one and the backend id is unknown.
MODEL_ID=llama.cpp
# Port the proxy listens on.
PORT=8081
# Overall HTTP timeout to a backend (seconds).
REQUEST_TIMEOUT=600
# How long to wait for a free slot when all slots are busy (seconds); 503 after.
ACQUIRE_TIMEOUT=300
# Max seconds a big request waits for an in-flight save of a prefix of its own
# conversation before giving up on the restore (the previous message's meta
# lands only after its .bin write). 0 disables the wait.
SAVE_WAIT_TIMEOUT=30
# Log level: DEBUG, INFO, WARNING, ERROR.
LOG_LEVEL=INFO

# --- Cache matching -------------------------------------------------------
# Words per block for the block-LCP fallback matcher.
WORDS_PER_BLOCK=100
# Requests with more words than this are "big" (restored + saved to disk).
BIG_THRESHOLD_WORDS=500
# Minimum LCP ratio (0..1) for a block-LCP restore candidate to be accepted.
LCP_TH=0.6

# --- Model id discovery ---------------------------------------------------
# TTL (seconds) for the cached backend model id.
MODEL_ID_TTL=60
# Timeout (seconds) for the /v1/models probe.
MODEL_ID_TIMEOUT=5
# Retry interval (seconds) while the model id is still unknown.
UNKNOWN_MODEL_ID_RETRY=5
# Timeout (seconds) for fetching a backend's /metrics during a scrape.
METRICS_TIMEOUT=5

# --- Slot discovery -------------------------------------------------------
# Interval (seconds) between backend slot-state polls (GET /slots).
SLOT_POLL_INTERVAL_S=30

# --- Meta cache (local .meta descriptors) ---------------------------------
# Directory for .meta files, relative to the app directory.
META_DIR=kv_meta
# Evict metas older than this (hours).
META_TTL_H=24
# Evict when the number of meta files exceeds this.
META_MAX_FILES=1000
# Evict when the total meta size exceeds this (MB).
META_MAX_MB=512
# Interval (seconds) between periodic eviction runs.
EVICT_INTERVAL_S=3600

# --- Backend .bin cache (mounted --slot-save-path) ------------------------
# Directory holding llama.cpp .bin slot files (the host --slot-save-path).
# Empty disables direct .bin cleanup.
BIN_CACHE_DIR=
# Max total size (MB) of .bin files; oldest (LRU) are deleted first. 0 disables.
BIN_CACHE_MAX_MB=0
# Interval (seconds) between .bin LRU cleanup runs (defaults to EVICT_INTERVAL_S).
BIN_CACHE_INTERVAL_S=
# Interval (seconds) between meta/.bin reconciliations. 0 disables.
BIN_RECONCILE_INTERVAL_S=600
# Grace window (seconds): a .bin without a meta modified within this window is
# treated as an in-flight save and skipped. 0 disables the guard.
BIN_SAVE_GRACE_S=10
# Minimum size (MB) of a saved .bin to count as a real slot save. Below this
# the save is treated as an empty capture (e.g. slot erased mid-generation)
# and discarded without writing a meta. 0 disables the check.
MIN_BIN_SIZE_VALID=1

# --- Behavior -------------------------------------------------------------
# Clear a slot's KV cache before a small (non-cached) request to avoid
# cross-conversation contamination. Off by default (some builds auto-clear).
ERASE_BEFORE_SMALL=false
# Include reasoning_content/reasoning in the cache key and the saved
# assistant response, so distinct reasoning traces get distinct cache keys.
# Off by default (keys byte-identical to the legacy behavior).
REASONING_IN_KEY=false
